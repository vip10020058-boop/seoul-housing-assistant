# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 깃에 올리지 마세요.
UPSTAGE_API_KEY=
# 법제처 OPEN API 인증값. open.law.go.kr에서 신청한 OC(보통 이메일 앞부분)
LAW_OC=
PUBLIC_DATA_API_KEY=
# 승인된 서비스별 전용 키. 비우면 각 서비스는 PUBLIC_DATA_API_KEY를 시도합니다.
LH_API_KEY=
# 선택: LH 분양임대공고문 상세 조회 서비스를 별도 승인받은 키
LH_DETAIL_API_KEY=
MOLIT_API_KEY=
# HUG 안심전세포털 상습 채무불이행자 명단공개 키
HUG_API_KEY=

# API / server reliability controls (defaults shown)
API_TIMEOUT_SEC=25
API_MAX_CONCURRENCY=4
API_RETRY_ATTEMPTS=3
API_RETRY_MAX_DELAY_SEC=8
SERVER_MAX_CONCURRENCY=3
